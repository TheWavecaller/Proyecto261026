# Copia este archivo como .env.local y rellena los valores (Supabase → Project Settings → API Keys).

# URL del proyecto. Es pública, por eso lleva NEXT_PUBLIC_.
NEXT_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co
# Clave publicable. La app actual no la usa (todo pasa por el servidor); se deja para futuras lecturas públicas.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Clave secreta (sb_secret_… o la antigua service_role). SOLO servidor: nunca con prefijo NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=

# En producción las rutas de escritura están deshabilitadas hasta protegerlas con autenticación.
# Ponlo a true solo cuando la ruta /api/carga esté protegida.
ETL_PERMITIR_ESCRITURA=false

# Clave de MapTiler (cloud.maptiler.com → API keys). Es pública por diseño: restríngela por origen HTTP.
NEXT_PUBLIC_MAPTILER_KEY=
